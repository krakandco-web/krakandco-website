<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#7A1F1D' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }} &ndash; Opening Soon</title>

    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body style="min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; background-color: var(--color-bg-main); padding: 2rem;">
    <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 3rem 2rem; max-width: 480px; width: 100%; box-shadow: var(--shadow-md);">
      <div class="brand-logo" style="margin-bottom: 1.5rem; justify-content: center;">
        <img 
          src="{{ 'krak-logo-transparent.png' | asset_url }}" 
          alt="KRAK &amp; CO." 
          style="height: 58px; width: auto; object-fit: contain;"
        >
      </div>
      <span class="overline">OPENING SOON</span>
      <h1 style="font-size: 2.2rem; margin: 0.5rem 0 1rem;">India, In Every Crunch.</h1>
      <p style="font-size: 0.95rem; margin-bottom: 2rem; color: var(--color-text-muted);">
        We are crafting something special. Enter your store password below to preview.
      </p>

      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <div style="margin-bottom: 1rem;">
          <input type="password" name="password" placeholder="Enter store password" required style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill); background: var(--color-bg-main);">
        </div>
        <button type="submit" class="btn btn-primary btn-full">Enter Store</button>
      {% endform %}
    </div>
  </body>
</html>

