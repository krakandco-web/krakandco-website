{% comment %}
  KRAK & CO. — CUSTOMER LOGIN TEMPLATE
{% endcomment %}

<section class="section-spacing">
  <div class="container" style="max-width: 440px;">
    <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 2.5rem 2rem; box-shadow: var(--shadow-sm); text-align: center;">
      <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">Welcome Back</h1>
      <p style="font-size: 0.9rem; margin-bottom: 2rem;">Log in to access your orders and saved wishlist.</p>

      {% form 'customer_login' %}
        {{ form.errors | default_errors }}

        <div style="margin-bottom: 1.25rem; text-align: left;">
          <label for="CustomerEmail" class="pdp-label">Email</label>
          <input type="email" name="customer[email]" id="CustomerEmail" required style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill); background: var(--color-bg-main);">
        </div>

        <div style="margin-bottom: 1.5rem; text-align: left;">
          <label for="CustomerPassword" class="pdp-label">Password</label>
          <input type="password" name="customer[password]" id="CustomerPassword" required style="width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-pill); background: var(--color-bg-main);">
        </div>

        <button type="submit" class="btn btn-primary btn-full" style="height: 46px; font-size: 0.95rem;">
          Sign In
        </button>

        <div style="margin-top: 1.5rem; font-size: 0.85rem; color: var(--color-text-muted);">
          <span>New to Krak &amp; Co.?</span>
          <a href="{{ routes.account_register_url }}" style="color: var(--color-primary); font-weight: 600; text-decoration: underline;">Create an account</a>
        </div>
      {% endform %}
    </div>
  </div>
</section>

