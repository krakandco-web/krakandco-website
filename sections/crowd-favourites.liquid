{% comment %}
  KRAK & CO. — THE CROWD'S CRUNCHING FAVOURITES (BESTSELLERS SECTION)
{% endcomment %}

<section class="crowd-favourites-section section-spacing">
  <div class="container">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 style="font-family: var(--font-heading); font-size: clamp(2rem, 3.2vw, 2.7rem); margin-bottom: 0.4rem;">
          {{ section.settings.heading | default: "The crowd's crunching favourites." }}
        </h2>
        <p style="color: var(--color-text-muted); font-size: 1.05rem;">
          {{ section.settings.subheading | default: "The snacks people keep reaching for. Find your favourite, or discover a new one." }}
        </p>
      </div>
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="link-with-arrow" style="font-weight: 700; color: var(--color-primary); font-size: 1rem;">
        {{ section.settings.view_all_text | default: 'SHOP ALL SNACKS' }} &rarr;
      </a>
    </div>

    <div class="grid grid--4-col">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {% assign img_pouch_1 = 'pouch-thenkulzal-murukku-card.png' | asset_url %}
        {% assign img_pouch_2 = 'pouch-peri-peri-murukku-card.png' | asset_url %}
        {% assign img_pouch_3 = 'pouch-thika-namki-card.png' | asset_url %}
        {% assign img_pouch_4 = 'hero-krak-official-pouches.png' | asset_url %}

        {% render 'product-card', 
          title: 'Thenkulzal Murukku', 
          price: '₹199', 
          weight: '150 g', 
          handle: 'thenkulzal-murukku', 
          url: '/products/thenkulzal-murukku',
          image_src: img_pouch_1,
          category: 'murukku traditional'
        %}

        {% render 'product-card', 
          title: 'Peri Peri Murukku', 
          price: '₹219', 
          weight: '150 g', 
          handle: 'peri-peri-murukku', 
          url: '/products/peri-peri-murukku',
          image_src: img_pouch_2,
          category: 'murukku spicy'
        %}

        {% render 'product-card', 
          title: 'Thika Namki', 
          price: '₹189', 
          weight: '150 g', 
          handle: 'thika-namki', 
          url: '/products/thika-namki',
          image_src: img_pouch_3,
          category: 'namki spicy'
        %}

        {% render 'product-card', 
          title: 'KRAK Snack Trio Bundle', 
          price: '₹549', 
          weight: '450 g', 
          handle: 'krak-snack-trio', 
          url: '/products/krak-snack-trio',
          image_src: img_pouch_4,
          category: 'combo'
        %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Crowd Favourites",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The crowd's crunching favourites."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The snacks people keep reaching for. Find your favourite, or discover a new one."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured Collection"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "SHOP ALL SNACKS"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ]
}
{% endschema %}
