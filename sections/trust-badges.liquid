{% comment %}
  KRAK & CO. — TRUST BADGES / VALUE PROPOSITIONS BAR
{% endcomment %}

<section class="trust-badges-bar" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-bg-surface); padding: 1.65rem 0;">
  <div class="container">
    <div class="trust-badges-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; align-items: center;">
      
      <!-- Badge 1 -->
      <div class="trust-badge-item" style="display: flex; align-items: center; justify-content: center; gap: 0.85rem; text-align: left;">
        <span style="color: var(--color-primary); flex-shrink: 0;">
          {% render 'icon', name: 'leaf' %}
        </span>
        <span style="font-size: 0.88rem; font-weight: 600; color: var(--color-text-main); line-height: 1.3;">
          {{ section.settings.badge_1 | default: 'Authentic Indian Flavours' }}
        </span>
      </div>

      <!-- Badge 2 -->
      <div class="trust-badge-item" style="display: flex; align-items: center; justify-content: center; gap: 0.85rem; text-align: left;">
        <span style="color: var(--color-primary); flex-shrink: 0;">
          {% render 'icon', name: 'flask' %}
        </span>
        <span style="font-size: 0.88rem; font-weight: 600; color: var(--color-text-main); line-height: 1.3;">
          {{ section.settings.badge_2 | default: 'No Artificial Preservatives' }}
        </span>
      </div>

      <!-- Badge 3 -->
      <div class="trust-badge-item" style="display: flex; align-items: center; justify-content: center; gap: 0.85rem; text-align: left;">
        <span style="color: var(--color-primary); flex-shrink: 0;">
          {% render 'icon', name: 'mortar' %}
        </span>
        <span style="font-size: 0.88rem; font-weight: 600; color: var(--color-text-main); line-height: 1.3;">
          {{ section.settings.badge_3 | default: 'Premium Ingredients' }}
        </span>
      </div>

      <!-- Badge 4 -->
      <div class="trust-badge-item" style="display: flex; align-items: center; justify-content: center; gap: 0.85rem; text-align: left;">
        <span style="color: var(--color-primary); flex-shrink: 0;">
          {% render 'icon', name: 'truck' %}
        </span>
        <span style="font-size: 0.88rem; font-weight: 600; color: var(--color-text-main); line-height: 1.3;">
          {{ section.settings.badge_4 | default: 'Delivering Pan India' }}
        </span>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 860px) {
    .trust-badges-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 1.25rem !important;
    }
  }
  @media (max-width: 480px) {
    .trust-badges-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem !important;
    }
    .trust-badge-item {
      flex-direction: column !important;
      text-align: center !important;
      gap: 0.35rem !important;
      font-size: 0.78rem !important;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge 1 text",
      "default": "Authentic Indian Flavours"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Badge 2 text",
      "default": "No Artificial Preservatives"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Badge 3 text",
      "default": "Premium Ingredients"
    },
    {
      "type": "text",
      "id": "badge_4",
      "label": "Badge 4 text",
      "default": "Delivering Pan India"
    }
  ]
}
{% endschema %}

