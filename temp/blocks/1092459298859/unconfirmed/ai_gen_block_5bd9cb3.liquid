{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 32px 24px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-timeline-{{ ai_gen_id }}__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .ai-timeline-{{ ai_gen_id }}__heading {
    margin: 0 0 32px;
    color: {{ block.settings.heading_color }};
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.2;
  }

  .ai-timeline-{{ ai_gen_id }}__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 38px;
  }

  .ai-timeline-{{ ai_gen_id }}__track,
  .ai-timeline-{{ ai_gen_id }}__progress {
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: {{ block.settings.track_color }};
  }

  .ai-timeline-{{ ai_gen_id }}__progress {
    bottom: auto;
    height: 0;
    max-height: calc(100% - 24px);
    background: {{ block.settings.highlight_color }};
    transition: height 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item {
    position: relative;
    padding: 0 0 32px;
    opacity: .62;
    transition: opacity 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item:last-child { padding-bottom: 0; }
  .ai-timeline-{{ ai_gen_id }}__item.is-active { opacity: 1; }

  .ai-timeline-{{ ai_gen_id }}__marker {
    position: absolute;
    left: -33px;
    top: 3px;
    width: 14px;
    height: 14px;
    border: 2px solid {{ block.settings.track_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    box-sizing: border-box;
    transition: background-color 180ms ease-out, border-color 180ms ease-out, transform 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker {
    background: {{ block.settings.highlight_color }};
    border-color: {{ block.settings.highlight_color }};
    transform: scale(1.2);
  }

  .ai-timeline-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 6px;
    color: {{ block.settings.highlight_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .04em;
  }

  .ai-timeline-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    font-size: 20px;
    line-height: 1.3;
  }

  .ai-timeline-{{ ai_gen_id }}__body { line-height: 1.65; }
  .ai-timeline-{{ ai_gen_id }}__body p { margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .ai-timeline-{{ ai_gen_id }}__progress,
    .ai-timeline-{{ ai_gen_id }}__item,
    .ai-timeline-{{ ai_gen_id }}__marker { transition: none; }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-timeline-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <ol class="ai-timeline-{{ ai_gen_id }}__list">
      <span class="ai-timeline-{{ ai_gen_id }}__track" aria-hidden="true"></span>
      <span class="ai-timeline-{{ ai_gen_id }}__progress" aria-hidden="true"></span>
      {% for i in (1..5) %}
        {% assign title_key = 'step_' | append: i | append: '_title' %}
        {% assign date_key = 'step_' | append: i | append: '_label' %}
        {% assign body_key = 'step_' | append: i | append: '_body' %}
        {% assign step_title = block.settings[title_key] %}
        {% assign step_label = block.settings[date_key] %}
        {% assign step_body = block.settings[body_key] %}
        {% if step_title != blank or step_label != blank or step_body != blank %}
          <li class="ai-timeline-{{ ai_gen_id }}__item" data-timeline-item>
            <span class="ai-timeline-{{ ai_gen_id }}__marker" aria-hidden="true"></span>
            {% if step_label != blank %}<p class="ai-timeline-{{ ai_gen_id }}__eyebrow">{{ step_label | escape }}</p>{% endif %}
            {% if step_title != blank %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ step_title | escape }}</h3>{% endif %}
            {% if step_body != blank %}<div class="ai-timeline-{{ ai_gen_id }}__body">{{ step_body }}</div>{% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ScrollTimeline extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-timeline-item]'));
        this.progress = this.querySelector('.ai-timeline-{{ ai_gen_id }}__progress');
        if (!this.items.length || !this.progress) return;
        this.onScroll = () => this.updateActive();
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.items.forEach((item) => item.classList.toggle('is-active', item === entry.target));
              this.updateProgress(entry.target);
            }
          });
        }, { rootMargin: '-42% 0px -42% 0px', threshold: 0 });
        this.items.forEach((item) => this.observer.observe(item));
        window.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onScroll);
        this.updateActive();
      }
      updateActive() {
        const focusLine = window.innerHeight * 0.5;
        let active = this.items[0];
        this.items.forEach((item) => {
          if (item.getBoundingClientRect().top <= focusLine) active = item;
        });
        this.items.forEach((item) => item.classList.toggle('is-active', item === active));
        this.updateProgress(active);
      }
      updateProgress(active) {
        const listRect = this.querySelector('.ai-timeline-{{ ai_gen_id }}__list').getBoundingClientRect();
        const marker = active.querySelector('.ai-timeline-{{ ai_gen_id }}__marker').getBoundingClientRect();
        const total = Math.max(0, listRect.height - 24);
        const offset = Math.max(0, Math.min(total, marker.top + marker.height / 2 - listRect.top - 12));
        this.progress.style.height = `${offset}px`;
      }
      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        if (this.onScroll) {
          window.removeEventListener('scroll', this.onScroll);
          window.removeEventListener('resize', this.onScroll);
        }
      }
    }
    customElements.define(tagName, ScrollTimeline);
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our journey" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF7F0" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#7A1F1D" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1614" },
    { "type": "color", "id": "track_color", "label": "Timeline line", "default": "#E8DFD3" },
    { "type": "color", "id": "highlight_color", "label": "Highlight", "default": "#7A1F1D" },
    { "type": "header", "content": "Timeline steps" },
    { "type": "text", "id": "step_1_label", "label": "Step 1 label", "default": "The beginning" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "A love for regional flavours" },
    { "type": "richtext", "id": "step_1_body", "label": "Step 1 description", "default": "<p>Share the story of how your journey began.</p>" },
    { "type": "text", "id": "step_2_label", "label": "Step 2 label", "default": "The inspiration" },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "Discovering beloved recipes" },
    { "type": "richtext", "id": "step_2_body", "label": "Step 2 description", "default": "<p>Tell customers what inspired your distinctive snacks.</p>" },
    { "type": "text", "id": "step_3_label", "label": "Step 3 label", "default": "The craft" },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "Made with care" },
    { "type": "richtext", "id": "step_3_body", "label": "Step 3 description", "default": "<p>Describe the ingredients and care behind every batch.</p>" },
    { "type": "text", "id": "step_4_label", "label": "Step 4 label", "default": "The community" },
    { "type": "text", "id": "step_4_title", "label": "Step 4 title", "default": "Shared around the table" },
    { "type": "richtext", "id": "step_4_body", "label": "Step 4 description", "default": "<p>Celebrate the people who have joined your journey.</p>" },
    { "type": "text", "id": "step_5_label", "label": "Step 5 label", "default": "What's next" },
    { "type": "text", "id": "step_5_title", "label": "Step 5 title", "default": "A flavourful future" },
    { "type": "richtext", "id": "step_5_body", "label": "Step 5 description", "default": "<p>Share what you are excited to bring to customers next.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}